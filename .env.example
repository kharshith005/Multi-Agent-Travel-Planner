# Copy to .env and fill in values.

# ---- Required: Gemini on Vertex AI ----
VERTEX_AI_API_KEY=
GOOGLE_MAPS_API_KEY=
SERPAPI_API_KEY=

# Optional model override (falls back to gemini-2.5-flash-lite).
# Accepts short aliases: llama-3.3, mistral-small-3.1, gemini-flash-lite
LLM_MODEL=

# ---- Optional: Llama 3.3 / Mistral Small 3.1 on Vertex AI (Model Garden) ----
# Both models require GOOGLE_CLOUD_PROJECT + google-auth (ADC).
# Enable each model in Vertex AI Model Garden before first use (one-time per project).
GOOGLE_CLOUD_PROJECT=
# Path to a GCP service-account JSON key (alternative to `gcloud auth application-default login`).
GOOGLE_APPLICATION_CREDENTIALS=

# Region for Llama 3.3 70B Instruct. Supported: us-central1.
META_VERTEX_REGION=us-central1

# Region for Mistral Small 3.1. Supported: us-central1, europe-west4.
MISTRAL_VERTEX_REGION=us-central1
