# Copy to .env and fill in values.

# ---- Required: Gemini on Vertex AI ----
VERTEX_AI_API_KEY=
GOOGLE_MAPS_API_KEY=
SERPAPI_API_KEY=

# Optional model override (falls back to gemini-2.5-flash-lite).
# Must match a model ID in agents/models.py REGISTRY.
LLM_MODEL=

# ---- Optional: Claude on Vertex AI (Model Garden) ----
# GOOGLE_CLOUD_PROJECT and CLAUDE_VERTEX_REGION are both required to enable
# Claude model entries in the registry. If either is missing, all Claude entries
# are silently hidden from available_models().
# GPT/OpenAI is excluded: Vertex AI does not host OpenAI models.
#
# Supported Claude models (set LLM_MODEL to one of these IDs):
#   claude-haiku-4-5    — fast & low-cost
#   claude-sonnet-4-5   — premium reasoning
#   claude-sonnet-4-6   — premium reasoning
#
# Use region="global" for Anthropic's pooled Vertex endpoint (higher token quota
# than per-region endpoints like us-east5). Verify availability at:
# cloud.google.com/vertex-ai/generative-ai/docs/partner-models/use-claude
GOOGLE_CLOUD_PROJECT=
CLAUDE_VERTEX_REGION=global
# Path to a GCP service-account JSON key (alternative to `gcloud auth application-default login`).
GOOGLE_APPLICATION_CREDENTIALS=