# Copy to .env and fill in values.

# ---- Required: Gemini on Vertex AI ----
VERTEX_AI_API_KEY=
GOOGLE_MAPS_API_KEY=
SERPAPI_API_KEY=

# Optional model override (falls back to gemini-2.5-flash-lite).
# Must match a model ID or short alias in agents/models.py REGISTRY.
LLM_MODEL=

# ---- Optional: Llama 3.3 / Mistral Small 3.1 / GLM-5 on Vertex AI (Model Garden) ----
# All three models require GOOGLE_CLOUD_PROJECT + google-auth (ADC).
# Enable each model in Vertex AI Model Garden console first (one-time per project).
GOOGLE_CLOUD_PROJECT=
# Path to a GCP service-account JSON key (alternative to `gcloud auth application-default login`).
GOOGLE_APPLICATION_CREDENTIALS=

# Default region for Llama 3.3 70B Instruct. Supported: us-central1.
META_VERTEX_REGION=us-central1

# Default region for Mistral Small 3.1. Supported: us-central1, europe-west4.
MISTRAL_VERTEX_REGION=us-central1

# GLM-5 uses the global endpoint; no region prefix needed.
GLM_VERTEX_REGION=global
