# Copy to .env and fill in values.

# ---- Required: Gemini on Vertex AI ----
VERTEX_AI_API_KEY=
GOOGLE_MAPS_API_KEY=
SERPAPI_API_KEY=

# Optional model override (falls back to gemini-2.5-flash-lite).
# Must match a model ID in agents/models.py REGISTRY.
LLM_MODEL=

# ---- Optional: Claude on Vertex AI (Model Garden) ----
# All three are required to enable Claude model entries in the registry.
# If any are missing, Claude entries are silently hidden from available_models().
# GPT/OpenAI is excluded: Vertex AI does not host OpenAI models.
GOOGLE_CLOUD_PROJECT=
CLAUDE_VERTEX_REGION=us-east5
# Path to a GCP service-account JSON key (alternative to `gcloud auth application-default login`).
GOOGLE_APPLICATION_CREDENTIALS=